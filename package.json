{
  "name": "radar-campus-safety",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "seed": "node --env-file-if-exists=.env server/seed.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "check:supabase": "node --env-file-if-exists=.env scripts/check-supabase.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "admin:local": "node --env-file-if-exists=.env scripts/promote-local-admin.mjs",
    "test:lab": "node scripts/test-lab.mjs",
    "setup:integrations": "node scripts/setup-integrations.mjs",
    "config:check": "node --env-file-if-exists=.env scripts/config-check.mjs",
    "config:live": "node --env-file-if-exists=.env scripts/config-check.mjs --live",
    "backup:verify": "node scripts/verify-backup.mjs",
    "device:send": "node --env-file-if-exists=.env scripts/send-count.mjs",
    "check:vision": "node --env-file-if-exists=.env scripts/config-check.mjs --live --vision",
    "setup:gemini": "node scripts/setup-integrations.mjs --gemini"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/functions": "^3.10.3",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "framer-motion": "^14.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.31",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.183.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-leaflet": "^2.8.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "24.x"
  }
}
