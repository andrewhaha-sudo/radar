# Copy this file to .env. .env is ignored by Git.
# Keep sqlite until the private settings below are configured.
RADAR_DATABASE_DRIVER=sqlite

SUPABASE_URL=https://xtfbdaphayodkkgzwecb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YDiCB2Qh4uICJU7Omfz12g_awfpdBf4

# Copy the Session pooler connection string from Supabase → Connect.
# Replace [YOUR-PASSWORD] locally, and URL-encode special characters in the password.
# Never paste this connection string or a private key into chat or commit it.
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=radar-uploads

# Your own confirmed Supabase account email. Only this account gets the initial
# application administrator role when its application profile is first created.
RADAR_ADMIN_EMAIL=
RADAR_PUBLIC_URL=http://localhost:5173

# Optional external services. Keep private values in .env/server environment only.
# AI requires an explicit inspector action/consent before selected photos are sent.
RADAR_VISION_API_KEY=
RADAR_VISION_MODEL=gpt-4.1-mini
# Enables the documented USGS GeoJSON adapter; staff still choose when to sync.
RADAR_USGS_FEED_ENABLED=false
# Generate VAPID keys with: npx web-push generate-vapid-keys
RADAR_VAPID_PUBLIC_KEY=
RADAR_VAPID_PRIVATE_KEY=
RADAR_VAPID_SUBJECT=
# Optional Twilio SMS, consented recipients only; charges may apply.
RADAR_TWILIO_SID=
RADAR_TWILIO_TOKEN=
RADAR_TWILIO_FROM=

# Optional for local SQLite registration; cloud sign-up is controlled in Supabase.
RADAR_ALLOW_LOCAL_SIGNUP=true
# Optional authenticated Vercel/external scheduler. Use a long random secret.
CRON_SECRET=
